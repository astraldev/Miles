This patch is needed because blueprint-compiler 0.22.2 fails to run as a subproject,
due to its script being generated in the build folder, where it cannot find
its own Python module.

It also asks for a Python that has PyGObject, which the macOS system Python does not.

diff --git a/data/blueprint-compiler.py.in b/data/blueprint-compiler.py.in
index c450a91..3dc1de4 100755
--- a/data/blueprint-compiler.py.in
+++ b/data/blueprint-compiler.py.in
@@ -22,6 +22,10 @@
 # This is the blueprint-compiler script that meson configures and installs. Its shebang line is configured with the
 # path to the environment's python executable.
 
+import sys
+
+sys.path.insert(0, "@SOURCEDIR@")
+
 from blueprintcompiler import main
 
 if __name__ == "__main__":
diff --git a/meson.build b/meson.build
index 97626f2..c7c5a8b 100644
--- a/meson.build
+++ b/meson.build
@@ -5,7 +5,7 @@ project('blueprint-compiler',
 prefix = get_option('prefix')
 datadir = join_paths(prefix, get_option('datadir'))
 
-py = import('python').find_installation('python3')
+py = import('python').find_installation('python3', modules: ['gi'])
 
 required_python_version = '>=3.9'
 if not py.language_version().version_compare(required_python_version)
@@ -39,7 +39,7 @@ if not get_option('python_wheel')
   blueprint_compiler = configure_file(
     input: 'data/blueprint-compiler.py.in',
     output: 'blueprint-compiler',
-    configuration: { 'PYTHON': py.full_path() },
+    configuration: { 'PYTHON': py.full_path(), 'SOURCEDIR': meson.current_source_dir() },
     install: not meson.is_subproject(),
     install_dir: get_option('bindir'),
     install_mode: 'rwxr-xr-x',
