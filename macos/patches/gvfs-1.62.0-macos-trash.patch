This patch is needed because gvfs 1.62.0 shows an empty trash on mac, due to
looking for trashed files in the Linux trash folders, which mac does not have.

Mac does not record where a trashed file came from in a way gvfs reads,
so files cannot be restored from the trash, and have no trashed-on date.

diff --git a/daemon/trashlib/trashdir.c b/daemon/trashlib/trashdir.c
index 6b5f21c..aba2954 100644
--- a/daemon/trashlib/trashdir.c
+++ b/daemon/trashlib/trashdir.c
@@ -80,6 +80,16 @@ trash_dir_set_files (TrashDir   *dir,
   trash_root_thaw (dir->root);
 }
 
+static gboolean
+trash_dir_skips_name (const char *name)
+{
+#ifdef __APPLE__
+  return strcmp (name, ".DS_Store") == 0 || strcmp (name, ".expunged") == 0;
+#else
+  return FALSE;
+#endif
+}
+
 static void
 trash_dir_empty (TrashDir *dir)
 {
@@ -116,8 +126,11 @@ trash_dir_enumerate (TrashDir *dir)
           const gchar *name;
 
           name = g_file_info_get_name (info);
-          file = g_file_get_child (dir->directory, name);
-          g_hash_table_insert (files, g_strdup (name), file);
+          if (!trash_dir_skips_name (name))
+            {
+              file = g_file_get_child (dir->directory, name);
+              g_hash_table_insert (files, g_strdup (name), file);
+            }
 
           g_object_unref (info);
         }
@@ -141,7 +154,7 @@ trash_dir_changed (GFileMonitor      *monitor,
     {
       g_autofree gchar *name = g_file_get_basename (file);
 
-      if (!g_hash_table_contains (dir->items, name))
+      if (!trash_dir_skips_name (name) && !g_hash_table_contains (dir->items, name))
         {
           g_hash_table_insert (dir->items, g_steal_pointer (&name), g_object_ref (file));
           trash_root_add_item (dir->root, file, dir->topdir, dir->is_homedir);
diff --git a/daemon/trashlib/trashitem.c b/daemon/trashlib/trashitem.c
index 08dd8ad..b1729c1 100644
--- a/daemon/trashlib/trashitem.c
+++ b/daemon/trashlib/trashitem.c
@@ -148,6 +148,12 @@ trash_item_get_trashinfo (GFile  *path,
   char *trashinfo;
   char *basename;
 
+#ifdef __APPLE__
+  *original = NULL;
+  *date = NULL;
+  return;
+#endif
+
   files = g_file_get_parent (path);
   trashdir = g_file_get_parent (files);
   trashpath = g_file_get_path (trashdir);
@@ -489,8 +495,13 @@ trash_item_delete (TrashItem  *item,
   guint unique;
   guint i;
 
+#ifdef __APPLE__
+  expunged = g_file_resolve_relative_path (item->file,
+                                           "../.expunged");
+#else
   expunged = g_file_resolve_relative_path (item->file,
                                            "../../expunged");
+#endif
   g_file_make_directory_with_parents (expunged, NULL, NULL);
   unique = g_random_int ();
 
@@ -538,6 +549,7 @@ trash_item_restore (TrashItem  *item,
       g_hash_table_remove (item->root->item_table, item->escaped_name);
       g_rw_lock_writer_unlock (&item->root->lock);
 
+#ifndef __APPLE__
       {
         GFile *trashinfo;
         gchar *basename;
@@ -552,6 +564,7 @@ trash_item_restore (TrashItem  *item,
         g_file_delete (trashinfo, NULL, NULL);
         g_object_unref (trashinfo);
       }
+#endif
 
       return TRUE;
     }
diff --git a/daemon/trashlib/trashwatcher.c b/daemon/trashlib/trashwatcher.c
index cf3ff7b..ff756f4 100644
--- a/daemon/trashlib/trashwatcher.c
+++ b/daemon/trashlib/trashwatcher.c
@@ -186,8 +186,13 @@ trash_mount_insert (TrashWatcher    *watcher,
    */
 
   /* (1) */
+#ifdef __APPLE__
+  mount->dirs[0] = trash_dir_new (watcher->root, watching, FALSE, mountpoint,
+                                  ".Trashes/%d", (int) getuid ());
+#else
   mount->dirs[0] = trash_dir_new (watcher->root, watching, FALSE, mountpoint,
                                   ".Trash/%d/files", (int) getuid ());
+#endif
 
   /* (2) */
   mount->dirs[1] = trash_dir_new (watcher->root, watching, FALSE, mountpoint,
@@ -398,14 +403,26 @@ trash_watcher_new (TrashRoot *root)
   watcher->mount_monitor = g_unix_mount_monitor_get ();
   watcher->mounts_changed_id = 0;
 
+#ifdef __APPLE__
+  user_datadir = g_file_new_for_path (g_get_home_dir ());
+  homedir_trashdir = g_file_get_child (user_datadir, ".Trash");
+#else
   user_datadir = g_file_new_for_path (g_get_user_data_dir ());
   homedir_trashdir = g_file_get_child (user_datadir, "Trash/files");
+#endif
   homedir_mount = find_mount_entry_for_file (homedir_trashdir);
   watcher->homedir_type = decide_watch_type (homedir_mount, TRUE);
+#ifdef __APPLE__
+  watcher->homedir_trashdir = trash_dir_new (watcher->root,
+                                             FALSE, TRUE,
+                                             g_get_home_dir (),
+                                             ".Trash");
+#else
   watcher->homedir_trashdir = trash_dir_new (watcher->root,
                                              FALSE, TRUE,
                                              g_get_user_data_dir (),
                                              "Trash/files");
+#endif
 
   if (homedir_mount)
     g_unix_mount_entry_free (homedir_mount);
